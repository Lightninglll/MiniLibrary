// Zadanie 1 i Zadanie 2: Klasa Product
class Product {
    // Pola instancyjne (dla każdego obiektu osobne)
    private String name;
    private double price;
    private String category;
    private boolean available;

    // Pole statyczne (wspólne dla całej klasy)
    public static int productCount = 0;

    // Konstruktor
    public Product(String name, double price, String category, boolean available) {
        this.name = name;
        this.price = price;
        this.category = category;
        this.available = available;
        
        // Zwiększamy statyczny licznik przy tworzeniu każdego obiektu
        productCount++;
    }

    // Metoda wypisująca informacje o produkcie
    public void printInfo() {
        System.out.println("Produkt: " + name + " | Cena: " + price + " zł | Kategoria: " + category + " | Dostępny: " + (available ? "Tak" : "Nie"));
    }
}

// Zadanie 3: Klasa LibraryMember
class LibraryMember {
    // Pole final (nie można go zmienić po przypisaniu wartości)
    private final String memberId;
    private String name;

    public LibraryMember(String memberId, String name) {
        this.memberId = memberId;
        this.name = name;
    }

    public void printMemberInfo() {
        System.out.println("Czytelnik: " + name + " | ID: " + memberId);
    }
}

// Zadanie 4: Klasa VisitCounter
class VisitCounter {
    // Pole klasy (zachowuje swój stan między wywołaniami metod na tym obiekcie)
    private int fieldCounter = 0;

    public void visit() {
        // Zmienna lokalna (tworzona i niszczona przy każdym wywołaniu metody)
        int localCounter = 0;

        fieldCounter++;
        localCounter++;

        System.out.println("Zmienna lokalna: " + localCounter + " | Pole klasy (fieldCounter): " + fieldCounter);
    }
}

// Zadanie 5: Klasa ScoreBoard
class ScoreBoard {
    // Pola instancyjne opisu wyników jednego meczu
    private String teamA;
    private String teamB;
    private int scoreA;
    private int scoreB;

    // Pole statyczne liczące wszystkie rozegrane mecze
    public static int totalMatches = 0;

    public ScoreBoard(String teamA, String teamB, int scoreA, int scoreB) {
        this.teamA = teamA;
        this.teamB = teamB;
        this.scoreA = scoreA;
        this.scoreB = scoreB;
        
        totalMatches++;
    }

    public void printMatchResult() {
        System.out.println("Mecz: " + teamA + " " + scoreA + " : " + scoreB + " " + teamB);
    }
}

