public class Film {
    private String tytul;
    private String rezyser;
    private int rokProdukcji;
    private boolean obejrzany;

    public Film(String tytul, String rezyser, int rokProdukcji, boolean obejrzany) {
        this.tytul = tytul;
        this.rezyser = rezyser;
        this.rokProdukcji = rokProdukcji;
        this.obejrzany = obejrzany;
    }

    public void obejrzyj() {
        this.obejrzany = true;
    }

    @Override
    public String toString() {
        return "Film: " + tytul + " | Reżyser: " + rezyser + 
               " | Rok: " + rokProdukcji + " | Obejrzany: " + (obejrzany ? "Tak" : "Nie");
    }

    public static void main(String[] args) {
        Film film1 = new Film("Incepcja", "Christopher Nolan", 2010, false);
        Film film2 = new Film("Nietykalni", "Olivier Nakache", 2011, true);

        System.out.println(film1);
        System.out.println(film2);

        System.out.println("\nOglądamy film 1...");
        film1.obejrzyj();
        System.out.println(film1);
    }
}

