public class KalkulatorLiczb {

    // Metoda przyjmująca dowolną liczbę argumentów całkowitych (varargs)
    public static void printNumbers(int... numbers) {
        System.out.print("Przekazane liczby: ");
        if (numbers.length == 0) {
            System.out.println("(brak argumentów - pusta tablica)");
            return;
        }

        for (int n : numbers) {
            System.out.print(n + " ");
        }
        System.out.println();
    }

    // Dodatkowy przykład: obliczanie sumy dowolnej liczby elementów
    public static int sum(int... numbers) {
        int suma = 0;
        for (int n : numbers) {
            suma += n;
        }
        return suma;
    }

    public static void main(String[] args) {
        // Wywołania z różną liczbą argumentów
        printNumbers(1, 2, 3);
        printNumbers(10, 20);
        printNumbers(); // Wywołanie bez argumentów (pusta tablica)

        System.out.println("Suma (1, 2, 3): " + sum(1, 2, 3));
        System.out.println("Suma (10, 20, 30, 40): " + sum(10, 20, 30, 40));
    }
}



