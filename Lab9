import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

interface Shape {
    double area();
    double perimeter();
    void describe();
}

abstract class AbstractShape implements Shape, Comparable<Shape> {
    protected String name;

    public AbstractShape(String name) {
        this.name = name;
    }

    @Override
    public void describe() {
        System.out.printf("Figura: %s | Pole: %.2f | Obwód: %.2f%n", name, area(), perimeter());
    }

    @Override
    public int compareTo(Shape other) {
        return Double.compare(this.area(), other.area());
    }
}

class Circle extends AbstractShape {
    private double radius;

    public Circle(double radius) {
        super("Koło");
        this.radius = radius;
    }

    @Override
    public double area() {
        return Math.PI * radius * radius;
    }

    @Override
    public double perimeter() {
        return 2 * Math.PI * radius;
    }
}

class Rectangle extends AbstractShape {
    private double width;
    private double height;

    public Rectangle(double width, double height) {
        super("Prostokąt");
        this.width = width;
        this.height = height;
    }

    @Override
    public double area() {
        return width * height;
    }

    @Override
    public double perimeter() {
        return 2 * (width + height);
    }
}

public class MainTask7 {
    public static void main(String[] args) {
        List<AbstractShape> shapes = new ArrayList<>();
        shapes.add(new Circle(5.0));       // Pole ~ 78.54
        shapes.add(new Rectangle(4.0, 5.0)); // Pole = 20.00
        shapes.add(new Circle(2.0));       // Pole ~ 12.57

        Collections.sort(shapes);

        for (AbstractShape s : shapes) {
            s.describe();
        }
    }
}

