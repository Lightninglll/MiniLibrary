interface Reportable {
    String generateReport();
}

class Invoice implements Reportable {
    private String invoiceNumber;
    private double total;

    public Invoice(String invoiceNumber, double total) {
        this.invoiceNumber = invoiceNumber;
        this.total = total;
    }

    @Override
    public String generateReport() {
        return "Raport Faktury [" + invoiceNumber + "]: Kwota " + total + " PLN";
    }
}

class Employee implements Reportable {
    private String name;
    private int hoursWorked;

    public Employee(String name, int hoursWorked) {
        this.name = name;
        this.hoursWorked = hoursWorked;
    }

    @Override
    public String generateReport() {
        return "Raport Pracownika [" + name + "]: Przepracowano " + hoursWorked + " godz.";
    }
}

