abstract class Beverage {
    public final void prepare() {
        boilWater();
        brew();
        pourIntoCup();
        addExtras();
    }

    private void boilWater() {
        System.out.println("Gotowanie wody...");
    }

    private void pourIntoCup() {
        System.out.println("Nalewanie do filiżanki...");
    }

    protected abstract void brew();
    protected abstract void addExtras();
}

class Tea extends Beverage {
    @Override
    protected void brew() {
        System.out.println("Parzenie liści herbaty...");
    }

    @Override
    protected void addExtras() {
        System.out.println("Dodawanie cytryny i miodu.");
    }
}

class Coffee extends Beverage {
    @Override
    protected void brew() {
        System.out.println("Parzenie mielonej kawy pod ciśnieniem...");
    }

    @Override
    protected void addExtras() {
        System.out.println("Dodawanie mleka i cukru.");
    }
}

public class MainTask9 {
    public static void main(String[] args) {
        Beverage tea = new Tea();
        tea.prepare();

        System.out.println("---");

        Beverage coffee = new Coffee();
        coffee.prepare();
    }
}
